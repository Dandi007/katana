+
+    # 步骤 2：before 快照
+    before = snapshot(cwd)
+
+    # 步骤 3：触发 claude
+    prompt = contract.prompt or None
+    turns = contract.turns or None
+    if prompt and turns:
+        raise ValueError("contract has both prompt and turns")
+    if not prompt and not turns:
+        raise ValueError("contract has neither prompt nor turns")
+    res = trigger_run(
+        prompt=prompt,
+        turns=turns,
+        cwd=cwd,
+        log_dir=case_dir,
