#!/usr/bin/env bash
# SessionStart hook: scan memory cards and inject the <memory-index> as
# additionalContext. Pure shell + awk — no compiled binary, no download, no
# build step, so it ships intact in the npm package and runs anywhere bash+awk
# exist. (Replaces the former Rust `claude-memory-scan` binary; see
# docs/specs/2026-06-08-shell-rewrite.md.)
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
source "${SCRIPT_DIR}/katana-config.sh"

AWK_PROG="${SCRIPT_DIR}/scan-memory.awk"

# Memory paths: env > .katana > default (identical resolution to the old binary).
SYSTEM_MEMORY="${CLAUDE_MEMORY_SYSTEM_DIR:-${HOME}/.claude/memory}"
PROJECT_MEMORY="$(katana_config_get "memory_project_dir" "${CLAUDE_PROJECT_DIR:-$(pwd)}/memory" "CLAUDE_MEMORY_PROJECT_DIR")"

# Collect byte-sorted *.md lists (parity with the Rust PathBuf sort). A missing
# directory simply yields no files — the scanner then emits nothing for it.
sysfiles=(); projfiles=()
if [ -d "$SYSTEM_MEMORY" ]; then
    while IFS= read -r -d '' f; do sysfiles+=("$f"); done \
        < <(find "$SYSTEM_MEMORY" -maxdepth 1 -name '*.md' -print0 2>/dev/null | LC_ALL=C sort -z)
fi
if [ -d "$PROJECT_MEMORY" ]; then
    while IFS= read -r -d '' f; do projfiles+=("$f"); done \
        < <(find "$PROJECT_MEMORY" -maxdepth 1 -name '*.md' -print0 2>/dev/null | LC_ALL=C sort -z)
fi

# No cards anywhere → emit nothing (never block the session).
if [ "${#sysfiles[@]}" -eq 0 ] && [ "${#projfiles[@]}" -eq 0 ]; then
    exit 0
fi

# Note: `${arr[@]+"${arr[@]}"}` safely expands to nothing for an empty array
# under `set -u` on macOS bash 3.2 (plain `"${arr[@]}"` would error there).
exec awk \
    -v nsys="${#sysfiles[@]}" \
    -v sysdir="$SYSTEM_MEMORY" \
    -v projdir="$PROJECT_MEMORY" \
    -f "$AWK_PROG" -- ${sysfiles[@]+"${sysfiles[@]}"} ${projfiles[@]+"${projfiles[@]}"}
