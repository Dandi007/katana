#!/usr/bin/env bash
# SessionStart hook: 从 katana-memory-mcp 服务拉取 <memory-index> hook JSON 注入。
# 数据访问 100% 收敛到 MCP 服务；本 hook 只是一个带降级的 curl。
set -euo pipefail

URL="${KATANA_MEMORY_MCP_URL:-http://127.0.0.1:5605}"
TENANT="${KATANA_MEMORY_TENANT:-uther}"

if out="$(curl -fsS --max-time 3 "${URL}/t/${TENANT}/index" 2>/dev/null)" && [ -n "$out" ]; then
    printf '%s\n' "$out"
else
    printf '{"hookSpecificOutput":{"hookEventName":"SessionStart","additionalContext":"<memory-index>\\nmemory service unavailable at %s (tenant=%s) — memory_* tools 与索引本 session 不可用\\n</memory-index>"}}\n' "$URL" "$TENANT"
fi
