#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
PLUGIN_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"

source "${SCRIPT_DIR}/katana-config.sh"

# wiki_root：显式声明才激活（默认空 → 静默退出，零打扰）
WIKI_ROOT="$(katana_config_get "wiki_root" "" "KATANA_WIKI_ROOT")"
[ -z "$WIKI_ROOT" ] && exit 0

# 安全校验：locale 无关的黑名单。
# 拒绝路径穿越与 shell 危险字符，放行字母数字 / _ . - 空格 ~ 及任意非 ASCII（如中文）路径。
# 早期版本用含 CJK 范围 `一-鿿` 的白名单 ERE：`[[ =~ ]]` 走 glibc regcomp，在 UTF-8
# locale 下该多字节范围触发 "Invalid collation character"，导致合法 wiki_root（如 "."）
# 被误判非法、hook 恒以 exit 1 退出、using-wiki 约定无法注入。`case` glob 字节级、
# locale 无关；`~` 保留以供下方 katana_resolve_path 做 home 展开。
case "$WIKI_ROOT" in
    *".."* | *'`'* | *'$'* | *';'* | *'&'* | *'|'* | *'<'* | *'>'* \
    | *'('* | *')'* | *'{'* | *'}'* | *'['* | *']'* | *'*'* | *'?'* \
    | *'!'* | *'"'* | *"'"* | *'\'* | *$'\n'* | *$'\r'* | *$'\t'*)
        echo "Error: wiki_root contains invalid characters or path traversal: $WIKI_ROOT" >&2
        exit 1
        ;;
esac

# per-suite 开关：mcp 模式不灌 full using-wiki，只注一行触发器（二选一）
WIKI_INTERFACE="$(katana_config_get "wiki_interface" "skill" "KATANA_WIKI_INTERFACE")"

if [ "$WIKI_INTERFACE" = "mcp" ]; then
    content="本项目 wiki 走 MCP（非 skill 模式）：知识问题先调 wiki_query 再答（勿凭记忆裸答）；检索用 wiki_search，据返回的逻辑路径深挖须用 wiki MCP 的 fs_read/fs_glob，勿用原生文件工具；入库走 wiki_ingest_plan → wiki_ingest_apply（apply 强制 provenance/outlink/frontmatter 不变量）。协议细节由各 tool 返回值下发。"
else
    # Legacy skill mode still uses the client-visible root and activation marker.
    WIKI_ROOT="$(katana_resolve_path "$WIKI_ROOT")"
    [ -f "${WIKI_ROOT}/WIKI.md" ] || exit 0
    content=$(cat "${PLUGIN_ROOT}/skills/using-wiki/SKILL.md" 2>/dev/null || true)
    [ -z "$content" ] && exit 0

    # 占位替换：SKILL.md 中的 {{WIKI_ROOT}} → 实际路径
    content="${content//\{\{WIKI_ROOT\}\}/${WIKI_ROOT}}"
fi

escape_for_json() {
    local s="$1"
    s="${s//\\/\\\\}"; s="${s//\"/\\\"}"
    s="${s//$'\n'/\\n}"; s="${s//$'\r'/\\r}"; s="${s//$'\t'/\\t}"
    printf '%s' "$s"
}

printf '{"hookSpecificOutput":{"hookEventName":"SessionStart","additionalContext":"%s"}}\n' \
    "$(escape_for_json "$content")"
