#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
PLUGIN_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"

source "${SCRIPT_DIR}/katana-config.sh"

# wiki_root：显式声明才激活（默认空 → 静默退出，零打扰）
WIKI_ROOT="$(katana_config_get "wiki_root" "" "KATANA_WIKI_ROOT")"
[ -z "$WIKI_ROOT" ] && exit 0

# 安全校验：拒绝路径穿越与非法字符
if [[ ! "$WIKI_ROOT" =~ ^[a-zA-Z0-9/_.一-鿿~\ \-]+$ ]] || [[ "$WIKI_ROOT" == *".."* ]]; then
    echo "Error: wiki_root contains invalid characters or path traversal: $WIKI_ROOT" >&2
    exit 1
fi

# 解析为绝对路径：~ 展开 / 绝对原样 / 相对则 join kb_root（基准从 cwd 变 kb_root）
WIKI_ROOT="$(katana_resolve_path "$WIKI_ROOT")"

# 未初始化（无 WIKI.md）→ 静默退出，init 会创建
[ -f "${WIKI_ROOT}/WIKI.md" ] || exit 0

# per-suite 开关：mcp 模式不灌 full using-wiki，只注一行触发器（二选一）
WIKI_INTERFACE="$(katana_config_get "wiki_interface" "skill" "KATANA_WIKI_INTERFACE")"

if [ "$WIKI_INTERFACE" = "mcp" ]; then
    content="本项目 wiki 走 MCP（非 skill 模式）：知识问题先调 wiki_query 再答（勿凭记忆裸答）；检索用 wiki_search（返回带路径候选，可据路径自行 read/grep 深挖）；入库走 wiki_ingest_plan → wiki_ingest_apply（apply 强制 provenance/outlink/frontmatter 不变量）。协议细节由各 tool 返回值下发。"
else
    content=$(cat "${PLUGIN_ROOT}/skills/using-wiki/SKILL.md" 2>/dev/null || true)
    [ -z "$content" ] && exit 0

    # 占位替换：SKILL.md 中的 {{WIKI_ROOT}} → 实际路径
    content="${content//\{\{WIKI_ROOT\}\}/${WIKI_ROOT}}"
fi

escape_for_json() {
    local s="$1"
    s="${s//\\/\\\\}"; s="${s//\"/\\\"}"
    s="${s//$'\n'/\\n}"; s="${s//$'\r'/\\r}"; s="${s//$'\t'/\\t}"
    printf '%s' "$s"
}

printf '{"hookSpecificOutput":{"hookEventName":"SessionStart","additionalContext":"%s"}}\n' \
    "$(escape_for_json "$content")"
