#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
PLUGIN_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"

source "${SCRIPT_DIR}/katana-config.sh"

# retrieval_sources：显式声明才激活（默认空 → 静默退出，零打扰）
SOURCES="$(katana_config_get "retrieval_sources" "" "KATANA_RETRIEVAL_SOURCES")"
[ -z "$SOURCES" ] && exit 0

content=$(cat "${PLUGIN_ROOT}/skills/using-retrieval/SKILL.md" 2>/dev/null || true)
[ -z "$content" ] && exit 0

# 占位替换：SKILL.md 中的 {{SOURCES}} → 实际源列表
content="${content//\{\{SOURCES\}\}/${SOURCES}}"

escape_for_json() {
    local s="$1"
    s="${s//\\/\\\\}"; s="${s//\"/\\\"}"
    s="${s//$'\n'/\\n}"; s="${s//$'\r'/\\r}"; s="${s//$'\t'/\\t}"
    printf '%s' "$s"
}

printf '{"hookSpecificOutput":{"hookEventName":"SessionStart","additionalContext":"%s"}}\n' \
    "$(escape_for_json "$content")"
