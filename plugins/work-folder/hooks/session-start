#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
PLUGIN_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"

# Source shared config parser
source "${SCRIPT_DIR}/katana-config.sh"

# Read work-folder path from config (env > .katana > default)
WF_PATH="$(katana_config_get "work_folder_path" "docs/work-records" "KATANA_WORK_FOLDER")"

# Sanitize via a locale-independent denylist: reject path traversal and
# shell-dangerous characters, while allowing alnum, / _ . - space and any
# non-ASCII (e.g. CJK) path. An allowlist regex with a multibyte range
# (`一-鿿`) is invalid under a C locale and would reject even ASCII paths in
# headless/CI shells — `case` globbing is byte-based and locale-safe.
case "$WF_PATH" in
    *".."* | *'`'* | *'$'* | *';'* | *'&'* | *'|'* | *'<'* | *'>'* \
    | *'('* | *')'* | *'{'* | *'}'* | *'['* | *']'* | *'*'* | *'?'* \
    | *'!'* | *'~'* | *'"'* | *"'"* | *'\'* | *$'\n'* | *$'\t'*)
        echo "Error: work_folder_path contains invalid characters or path traversal: $WF_PATH" >&2
        exit 1
        ;;
esac

# Read the template and substitute the path
content=$(cat "${PLUGIN_ROOT}/rules/work-folder.md" 2>/dev/null || true)
[ -z "$content" ] && exit 0

# Replace the default path in the template with the configured path
content="${content//docs\/work-records/${WF_PATH}}"

escape_for_json() {
    local s="$1"
    s="${s//\\/\\\\}"
    s="${s//\"/\\\"}"
    s="${s//$'\n'/\\n}"
    s="${s//$'\r'/\\r}"
    s="${s//$'\t'/\\t}"
    printf '%s' "$s"
}

printf '{"hookSpecificOutput":{"hookEventName":"SessionStart","additionalContext":"%s"}}\n' \
    "$(escape_for_json "$content")"
