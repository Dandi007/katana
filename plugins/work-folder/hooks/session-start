#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
PLUGIN_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"

# Source shared config parser
source "${SCRIPT_DIR}/katana-config.sh"

# Read work-folder path from config (env > .katana > default)
WF_PATH="$(katana_config_get "work_folder_path" "docs/work-records" "KATANA_WORK_FOLDER")"

# Sanitize via a locale-independent denylist: reject path traversal and
# shell-dangerous characters, while allowing alnum, / _ . - space and any
# non-ASCII (e.g. CJK) path. An allowlist regex with a multibyte range
# (`一-鿿`) is invalid under a C locale and would reject even ASCII paths in
# headless/CI shells — `case` globbing is byte-based and locale-safe.
case "$WF_PATH" in
    *".."* | *'`'* | *'$'* | *';'* | *'&'* | *'|'* | *'<'* | *'>'* \
    | *'('* | *')'* | *'{'* | *'}'* | *'['* | *']'* | *'*'* | *'?'* \
    | *'!'* | *'~'* | *'"'* | *"'"* | *'\'* | *$'\n'* | *$'\t'*)
        echo "Error: work_folder_path contains invalid characters or path traversal: $WF_PATH" >&2
        exit 1
        ;;
esac

# Resolve the (validated) relative value to an absolute path under the KB root
# so the injected guidance points at the real work-folder regardless of cwd.
WF_ABS="$(katana_resolve_path "$WF_PATH")"

# per-suite 开关：mcp 模式不灌 full work-folder rules，只注一行触发器（二选一）
WF_INTERFACE="$(katana_config_get "work_folder_interface" "skill" "KATANA_WORK_FOLDER_INTERFACE")"

if [ "$WF_INTERFACE" = "mcp" ]; then
    content="本项目 work-folder 走 MCP（非 skill 模式）：跨 session 工作先调 wf_create 建新 / wf_resume 恢复（resume 时 server 实跑环境验证，返回 MATCH/DRIFT/BROKEN；BROKEN 必停、只报阻塞勿进入工作状态）；存档调 wf_save（server 强制追加 progress changelog、覆盖 context 快照、重生成 Resume Guide）；找历史工作记录用 wf_search（返回带路径候选，可据路径自行 read/grep）。work folder 根：${WF_ABS}。协议细节由各 tool 返回值下发。"
else
    # Read the template and substitute the path
    content=$(cat "${PLUGIN_ROOT}/rules/work-folder.md" 2>/dev/null || true)
    [ -z "$content" ] && exit 0

    # Replace the default path in the template with the configured (absolute) path
    content="${content//docs\/work-records/${WF_ABS}}"
fi

escape_for_json() {
    local s="$1"
    s="${s//\\/\\\\}"
    s="${s//\"/\\\"}"
    s="${s//$'\n'/\\n}"
    s="${s//$'\r'/\\r}"
    s="${s//$'\t'/\\t}"
    printf '%s' "$s"
}

printf '{"hookSpecificOutput":{"hookEventName":"SessionStart","additionalContext":"%s"}}\n' \
    "$(escape_for_json "$content")"
