#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
PLUGIN_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"

# Work Folder 已是 MCP-only 接口。SessionStart 不读取 .katana、环境变量或
# client-side 物理路径；只注入稳定的 opaque-ID 使用契约。
content=$(cat "${PLUGIN_ROOT}/rules/work-folder.md" 2>/dev/null || true)
[ -z "$content" ] && exit 0

escape_for_json() {
    local s="$1"
    s="${s//\\/\\\\}"
    s="${s//\"/\\\"}"
    s="${s//$'\n'/\\n}"
    s="${s//$'\r'/\\r}"
    s="${s//$'\t'/\\t}"
    printf '%s' "$s"
}

printf '{"hookSpecificOutput":{"hookEventName":"SessionStart","additionalContext":"%s"}}\n' \
    "$(escape_for_json "$content")"
